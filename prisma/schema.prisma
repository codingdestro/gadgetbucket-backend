// Prisma Schema for Order Processing System
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite" // or "postgresql", "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String         @map("password")
  fullname      String         @map("fullname")
  cartSessionId String?        @map("cart_session_id")
  dateCreated   DateTime       @default(now()) @map("date_created")
  dateUpdated   DateTime       @updatedAt @map("date_updated")
  // Relations
  addresses     Address[]
  shoppingCarts ShoppingCart[]
  orders        Order[]

  @@map("users")
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  streetAddress String   @map("street_address")
  city          String
  state         String
  postalCode    String   @map("postal_code")
  dateCreated   DateTime @default(now()) @map("date_created")
  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Order         Order[]

  @@map("addresses")
}

model Product {
  id            String     @id @default(uuid())
  image         String
  categoryId    String?
  name          String
  description   String?
  price         Decimal
  category      String
  isDeleted     Boolean    @default(false) @map("is_deleted")
  stockQuantity Int        @default(100) @map("stock_quantity")
  dateCreated   DateTime   @default(now()) @map("date_created")
  dateUpdated   DateTime   @updatedAt @map("date_updated")
  // Relations
  cartItems     CartItem[]

  @@map("products")
}

model ShoppingCart {
  id          String     @id @default(uuid())
  userId      String
  sessionId   String     @unique
  dateCreated DateTime   @default(now()) @map("date_created")
  dateUpdated DateTime   @updatedAt @map("date_updated")
  // Relations
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  cartItems   CartItem[]
  Order       Order[]

  @@map("shopping_carts")
}

model CartItem {
  id          String   @id @default(uuid())
  cartId      String
  productId   String
  quantity    Int      @default(1)
  priceAtTime Decimal  @map("price")
  dateAdded   DateTime @default(now()) @map("date_added")

  // Relations
  cart    ShoppingCart @relation(fields: [cartId], references: [sessionId])
  product Product      @relation(fields: [productId], references: [id])

  @@unique([cartId, productId], name: "unique_cart_product")
  @@map("cart_items")
}

model Order {
  id                String       @id @default(uuid())
  orderStatus       OrderStatus  @default(pending) @map("order_status")
  totalAmount       Decimal      @map("total_amount")
  // Dates
  orderDate         DateTime     @default(now()) @map("order_date")
  shippedDate       DateTime?    @map("shipped_date")
  deliveredDate     DateTime?    @map("delivered_date")
  // Relations
  cartId            String       @map("cart_id")
  cart              ShoppingCart @relation(fields: [cartId], references: [sessionId])
  userId            String
  user              User         @relation(fields: [userId], references: [id])
  shippingAddressId String?      @map("shipping_address_id")
  payments          Payment[]
  addressId         String?
  Address           Address?     @relation(fields: [addressId], references: [id])

  @@map("orders")
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @map("order_id")
  transactionId     String?       @unique @map("transaction_id")
  paymentStatus     PaymentStatus @default(pending) @map("payment_status")
  paymentMethodType String        @map("payment_method_type")
  amount            Decimal
  paymentDate       DateTime      @default(now()) @map("payment_date")
  // Relations
  order             Order         @relation(fields: [orderId], references: [id])

  @@map("payments")
}

// Enums
enum OrderStatus {
  pending
  confirmed
  processing
  shipped
  delivered
  cancelled
  returned

  @@map("order_status")
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
  partially_refunded

  @@map("payment_status")
}

enum PaymentMethodType {
  credit_card
  debit_card
  paypal
  bank_transfer
  digital_wallet
  COD

  @@map("payment_method_type")
}
