{
  "name": "e-commerce-backend",
  "type": "module",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "build": "bun build ./src/main.ts --target=node --minify --outdir=build",
    "ts": "tsc-watch --onSuccess \" node src/index.js\"",
    "dev": "bun run src/main.ts",
    "watch": "bun --watch src/main.ts ",
    "db:generate": "bunx prisma generate",
    "db:migrate": "bunx prisma migrate dev --name init"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mocha": "^10.0.10",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "axios": "^1.11.0",
    "eslint": "^8.57.1",
    "supertest": "^6.3.4"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.13.0",
    "aws-sdk": "^2.1692.0",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mock-aws-s3": "^4.0.2",
    "nock": "^13.5.6",
    "pino": "^9.7.0",
    "uuid": "^9.0.1"
  }
}
